{
  "name": "ocr-app",
  "version": "0.1.0",
  "bin": {
    "ocr-app": "bin/ocr-app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cdk:deploy": "npx cdk deploy --all",
    "cdk:synth": "npx cdk synth --all",
    "cdk:diff": "npx cdk diff --all",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "init-admin": "npx ts-node scripts/init-admin.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "@types/pg": "^8.18.0",
    "aws-cdk": "^2.1111.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1009.0",
    "@aws-sdk/client-dynamodb": "^3.1009.0",
    "@aws-sdk/dsql-signer": "^3.1009.0",
    "@aws-sdk/lib-dynamodb": "^3.1009.0",
    "@aws-solutions-constructs/aws-cloudfront-s3": "^2.77.0",
    "aws-cdk-lib": "^2.191.0",
    "constructs": "^10.0.0",
    "deploy-time-build": "^0.3.24",
    "pg": "^8.20.0"
  }
}
